{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Start Livestock Management Demo",
      "type": "process",
      "command": "cmd.exe",
      "args": [
        "/d",
        "/c",
        "${workspaceFolder}\\RUN_DEMO.bat"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "isBackground": true,
      "problemMatcher": {
        "owner": "livestock-demo",
        "pattern": {
          "regexp": "^(?!)((.*))$",
          "kind": "file",
          "file": 1,
          "message": 2
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": "^\\[DEMO_BOOTSTRAP\\]",
          "endsPattern": "^\\[DEMO_READY\\]$"
        }
      },
      "presentation": {
        "reveal": "always",
        "focus": true,
        "panel": "dedicated",
        "clear": true,
        "showReuseMessage": false
      },
      "runOptions": {
        "instanceLimit": 1
      }
    }
  ]
}
