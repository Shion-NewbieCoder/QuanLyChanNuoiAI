# Server-side configuration only; export variables (no automatic .env loading).
# Core management works without AI keys. Never commit a real credential.
DJANGO_SECRET_KEY=
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
# Choose ONE provider. Primary KT3 evaluation uses this fixed OpenRouter model.
AI_PROVIDER=openrouter
OPENROUTER_API_KEY=
OPENROUTER_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MAX_RETRIES=0

# Optional OpenAI alternative: replace AI_PROVIDER above with openai.
# Keys are independent; neither provider falls back to the other provider's key.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-terra
OPENAI_MAX_RETRIES=0

# Shared application limits. Keep zero retries for controlled KT3 evaluation.
AI_TIMEOUT_SECONDS=30
AI_MAX_INPUT_BYTES=65536
