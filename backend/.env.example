# Server-side configuration only; export variables (no automatic .env loading).
# Core management works without an OpenAI key. Never commit a real credential.
DJANGO_SECRET_KEY=
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
AI_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-terra
AI_TIMEOUT_SECONDS=30
OPENAI_MAX_RETRIES=0
AI_MAX_INPUT_BYTES=65536
